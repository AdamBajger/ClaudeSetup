# REFERENCE ONLY. Live ~/workspaces/Caddyfile is regenerated by entrypoint.sh
# every pod start — edits there are lost. Only registered content is served.
#
#   Static:  webshare add <name> <dir>  ->  https://<host>/<name>/
#            webshare rm <name> | webshare list
#   Proxy:   snippet in ~/workspaces/caddy.d/<any>.caddy, e.g.
#              handle_path /myapp/* { reverse_proxy localhost:8501 }
#
# Shape picked by $CLAUDE_WEB_HOST:
#
#   set (k8s) — auto Let's Encrypt, HTTPS :443 (+ :80 redirect); certs in ~/workspaces/.caddy
#
#       {
#           storage file_system /home/claude/workspaces/.caddy
#           email you@example.com          # if CLAUDE_ACME_EMAIL set
#           acme_ca https://...            # if CLAUDE_ACME_CA set
#       }
#       claude-bajger.dyn.cloud.e-infra.cz {
#           root * /home/claude/workspaces/.public
#           file_server browse
#           import /home/claude/workspaces/caddy.d/*.caddy
#       }
#
#   unset (compose/local) — plain HTTP :8080
#
#       :8080 {
#           root * /home/claude/workspaces/.public
#           file_server browse
#           import /home/claude/workspaces/caddy.d/*.caddy
#       }
