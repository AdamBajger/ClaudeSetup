# Copy to `.env` (compose reads it). Mirrors Helm values. All optional except
# AUTHORIZED_KEYS.

# SSH pubkey(s) for `claude`, merged into authorized_keys. Multiline OK (quote):
#   AUTHORIZED_KEYS="ssh-ed25519 AAAA... you@host"
AUTHORIZED_KEYS=

# GitHub PAT → `gh auth login --with-token`.
GH_TOKEN=

# HuggingFace token (exported to SSH shells).
HF_TOKEN=

# Single-line JSON of ~/.claude/.credentials.json. Re-seeded only when value
# changes; CLI rotates it after. Example:
#   CLAUDE_CREDENTIALS_JSON={"claudeAiOauth":{"accessToken":"sk-ant-oat01-...","refreshToken":"sk-ant-ort01-...","expiresAt":...}}
CLAUDE_CREDENTIALS_JSON=

# YouTrack: set BOTH → MCP for issues, REST (youtrack-kb) for articles.
YT_HOST=
YT_TOKEN=

# caddy on :8080 → localhost:8080.
CLAUDE_WEB_ENABLED=true

# Orchestrator autostart (tmux + claude --remote-control). Named RC session →
# fresh + recognizable (unnamed reattaches to prior cloud session). Unset
# CLAUDE_AUTOSTART_CLAUDE_COMMAND → compose default.
CLAUDE_AUTOSTART_TMUX_SESSION_NAME=claude
# CLAUDE_AUTOSTART_CLAUDE_COMMAND=claude --remote-control "My Orchestrator" --dangerously-skip-permissions
