#!/usr/bin/env bash
# resume-worker <name> — restart worker in fresh RC tmux session, RESUMING its
# conversation (same id, full history). After pod bounce or dead RC link (can't
# re-attach in place). New conversation → spawn-worker.
# Registry = name set; dir, cfg, session id derived here (stored copies rot).
# Exit: 0 ready, 1 error, 3 started but not confirmed RC-active (reconcile it).
set -euo pipefail
NAME="${1:?usage: resume-worker <name>}"
WROOT=/home/claude/workspaces
REG="$WROOT/.workers.json"
[ -f "$REG" ] || { echo "no registry at $REG" >&2; exit 1; }
jq -e --arg n "$NAME" 'has($n)' "$REG" >/dev/null || { echo "no registry entry for '$NAME'" >&2; exit 1; }
DIR="$WROOT/$NAME"
[ -d "$DIR" ] || { echo "worker dir missing: $DIR" >&2; exit 1; }
tmux has-session -t "$NAME" 2>/dev/null && { echo "'$NAME' is already running" >&2; exit 1; }

CFG=$("$WROOT/bin/_worker-cfg" "$NAME" "$DIR")
# claude encodes cwd → projects dir name: every non-alphanumeric char → '-'
ENC=$(printf '%s' "$DIR" | sed 's/[^A-Za-z0-9]/-/g')

# Resume by derived id, never `-c` (latest-in-cwd loses to other live claude in dir,
# e.g. IDE session → wrong convo). 1: newest session record naming this tmux session.
shopt -s nullglob
SID=""
recs=("$CFG/sessions"/*.json)
if [ ${#recs[@]} -gt 0 ]; then
  SID=$(jq -rs --arg n "$NAME" '[.[] | select((.tmux // "") | startswith($n + ":"))]
                                | sort_by(.startedAt) | last | .sessionId // empty' "${recs[@]}") \
    || { echo "WARNING: unreadable session record under $CFG/sessions, falling back to transcripts" >&2; SID=""; }
fi
# 2: newest transcript under this worker's cfg.
if [ -z "$SID" ]; then
  transcripts=("$CFG/projects/$ENC"/*.jsonl)
  if [ ${#transcripts[@]} -gt 0 ]; then
    SID=$(basename "$(ls -t "${transcripts[@]}" | head -1)" .jsonl)
  fi
fi

if [ -n "$SID" ]; then
  echo "resuming '$NAME' by id $SID in $DIR"
  RESUME_ARGS="--resume \"$SID\""
else
  echo "resuming '$NAME': no transcript under $CFG, starting FRESH conversation" >&2
  RESUME_ARGS=""
fi
tmux new-session -d -s "$NAME" -x 400 -y 200 -c "$DIR" \
  "CLAUDE_CONFIG_DIR='$CFG' claude $RESUME_ARGS --remote-control \"$NAME\" --dangerously-skip-permissions"

# Dangerous-settings disclosure not persisted → re-blocks TUI every resume.
"$WROOT/bin/_trust-guard" "$NAME" 45 || echo "WARNING: trust-guard failed for '$NAME'" >&2

ready=no
for _ in $(seq 1 40); do
  tmux has-session -t "$NAME" 2>/dev/null || { echo "ERROR: '$NAME' tmux session died during startup" >&2; exit 1; }
  if tmux capture-pane -t "$NAME" -p | grep -qE '/remote-control is active|/rc active|Remote Control active'; then ready=yes; break; fi
  sleep 1
done
# Banner carries RC URL. Print, never store (dead on next restart).
URL=$(tmux capture-pane -t "$NAME" -p -S - | grep -oE 'https://claude\.ai/code/session_[A-Za-z0-9]+' | tail -1 || true)

echo "worker '$NAME' resumed (ready=$ready, session ${SID:-new})"
if [ -n "$URL" ]; then
  echo "  url: $URL"
else
  echo "  url: not in pane — open from claude.ai/code by session name"
  echo "  drive meanwhile: tell-worker $NAME '<msg>' / read-worker $NAME"
fi
# Timed-out poll: leave session running (may sit at modal) so manager can reconcile.
[ "$ready" = yes ] || { echo "WARNING: '$NAME' not confirmed RC-active — reconcile it" >&2; exit 3; }
